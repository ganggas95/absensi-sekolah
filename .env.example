# Use the server's fixed intranet IP address or a hostname resolvable by clients.
INTRANET_HOST=intranet.bca.local
JWT_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-before-first-admin-seed

# Absensi guru: jaringan sekolah = LAN host server, bukan IP container.
# Isi IP LAN mesin yang menjalankan Docker (Mac: ipconfig getifaddr en0).
SCHOOL_HOST_IP=192.168.8.10
SCHOOL_HOST_PREFIX=24
# Opsional, mengalahkan SCHOOL_HOST_IP bila diisi (pisahkan koma).
SCHOOL_NETWORK_CIDRS=
