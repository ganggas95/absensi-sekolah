DATABASE_URL=postgresql+psycopg://absensi:absensi@localhost:5432/absensi
JWT_SECRET_KEY=change-me
CORS_ORIGINS=http://localhost:3000
MEDIA_DIR=uploads
# Absensi guru: rentang IP jaringan sekolah (CIDR, pisahkan koma). Kosong = semua ditolak.
SCHOOL_NETWORK_CIDRS=192.168.8.0/24
# Alternatif: isi IP LAN host server (bukan IP container), CIDR di atas dikosongkan.
# SCHOOL_HOST_IP=192.168.8.10
# SCHOOL_HOST_PREFIX=24
REQUIRE_SCHOOL_NETWORK=true
TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128,172.16.0.0/12
TEACHER_LATE_TOLERANCE_MINUTES=10
